REACT_APP_STATIC_MODE=false
REACT_APP_BACKEND_URL=http://localhost:8001
REACT_APP_ADMIN_ASSET_VERSION=20260205

# Keep local demo usable if Supabase tables are not ready. Set false for hard-fail integration testing.
REACT_APP_DEMO_FALLBACK=true

# Supabase Auth (required for real login outside demo mode)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Set true for local/sales demos to show the clearly labeled Demo role switcher.
REACT_APP_DEMO_MODE=true
