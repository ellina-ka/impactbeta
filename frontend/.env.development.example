# Local full-stack / integration defaults
REACT_APP_STATIC_MODE=false
REACT_APP_BACKEND_URL=http://localhost:8001
REACT_APP_ADMIN_ASSET_VERSION=20260205

# Supabase workflow persistence. Use either REACT_APP_SUPABASE_URL or REACT_APP_SUPABASE_PROJECT_REF.
# Never place a Supabase secret/service-role key in a REACT_APP_* variable; browser env vars are public.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
# REACT_APP_SUPABASE_PROJECT_REF=your-project-ref
REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_publishable_key
# Legacy fallback if your project still exposes an anon key name:
# REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Local demos can keep fallback on. Set false for integration testing against Supabase.
REACT_APP_DEMO_MODE=true
REACT_APP_DEMO_FALLBACK=true
